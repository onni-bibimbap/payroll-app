# Onni Payroll — environment configuration.
# Copy to .env (gitignored) and fill in real values. The dev profile
# (`make up`) runs entirely on the local compose Postgres and needs NONE of
# these; the prod profile refuses to boot without DATABASE_URL and
# PAYROLL_SECRET.

# ---------------------------------------------------------------- runtime --
# Environment name: development | test | production.
# Compose sets this per profile; only set it here for host runs.
APP_ENV=development

# Python logging level for the backend: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Company name printed on payslips and PDF headers.
PAYROLL_COMPANY=Onni

# --------------------------------------------------------------- database --
# REQUIRED for the prod profile (no in-file default). SQLAlchemy URL, e.g.
#   Supabase: postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# The dev/test profiles ignore this and always use the local compose db.
DATABASE_URL=

# Password for the LOCAL compose Postgres (service `db`). Defaults to
# "payroll" for dev convenience; set a strong value before exposing anything.
POSTGRES_PASSWORD=payroll

# ---------------------------------------------------------------- secrets --
# REQUIRED for the prod profile (no in-file default). Signs session cookies —
# anyone holding it can forge an admin session. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PAYROLL_SECRET=

# ------------------------------------------------------ supabase (optional) --
# Supabase Storage for the private employee-docs bucket (signed URLs).
# Leave empty to disable document storage.
SUPABASE_URL=
# Service-role key — RESTRICTED secret, never expose to the browser.
SUPABASE_SERVICE_KEY=

# --------------------------------------------------- integrations (optional) --
# Google Sheet ID for the legacy registration-sheet sync. Leave empty to
# disable (the sheet holds live applicant PII — see SEC-08).
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------- seeding --
# Gate for the explicit one-shot demo seed (`make seed`). seed.py refuses to
# run unless this is "true"; it is never set by normal container startup.
SEED_DEMO_DATA=

# Demo/bootstrap account credentials used by seed.py (create-if-missing only;
# existing users are never modified). Override before seeding anywhere shared.
PREPARER_USER=preparer
PREPARER_PASS=preparer123
APPROVER_USER=approver
APPROVER_PASS=approver123
ADMIN_USER=admin
ADMIN_PASS=admin123
